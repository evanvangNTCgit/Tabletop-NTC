{
  "AllowedHosts": "*",
  "AppConfig": {
    "AppName": "NTC Interactive Tabletop Map"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=./TabletopDatabase.db"
  },
  "Serilog": {
    "MinimumLevel": "Verbose",
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp} [{Level:u3} {RequestId}] {Message} {Exception}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/NtcTableTopLogs.txt",
          "outputTemplate": "{Timestamp} [{Level:u3} {RequestId}] {Message} {Exception}{NewLine}"
        }
      }
    ]
  }
}
