@using System.Text
@model List<Sale>

@if(Model != null && Model.Count > 0)
{
    <table class="table cart-table">
        <tr>
            <th scope="col">Date</th>
            <th scope="col">Item(s)</th>
            <th scope="col">Price</th>
            <th scope="col">Tax</th>
            <th scope="col">Total</th>
            <th></th>
        </tr>
    @foreach(var sale in Model)
    {
        @* <div>
        <p>@sale.Price</p>
        <p>@sale.Date</p>
        </div> *@
        <tr>
            <td>@sale.Date</td>
            <td>
                @{
                    List<string> names = sale.SaleLines.Select(sl => sl.Piece.Name).ToList();
                }
                @string.Join(", ", names)
            </td>
                <td>@sale.UnTaxedPrice</td>
                <td>@sale.Tax</td>
                <td>@sale.Price</td>
        </tr>
    }
    </table>
}
else
{
    <div class="evan-no-sale-div">
    <p>You seem to have no transaction history</p>
    <p>Please contact The SA Alpha Spring 26' group if this is an issue.</p>
    </div>
}