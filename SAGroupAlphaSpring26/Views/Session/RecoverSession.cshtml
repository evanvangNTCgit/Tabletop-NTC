@model IEnumerable<Session>
<div>
    <h3>Restore Session</h3>
    <table class="table">
        <tr>
            <th>Session</th>
            <th>Action</th>
        </tr>
        @if (Model.Count() <= 0)
        {
            <tr>
                <td>Nothing</td>
                <td>You have no session to recover</td>
            </tr>
        }
        @foreach (Session s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td><a asp-controller="Session" asp-action="RecoverSessionConfirm" asp-route-id="@s.Id" class="btn btn-link">Restore</a></td>
            </tr>
        }
    </table>
</div>