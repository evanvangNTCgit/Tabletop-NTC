@model SAGroupAlphaSpring26.Models.Session

@{
    ViewData["Title"] = "Session Creation";
}

<body>
    <div b-pbe4b1c5lp class="main-content">

        <div class="text-center mb-5">
            <h1 class="mb-0">Session Creation</h1>
        </div>
        <form asp-action="Create" method="post">
            <div class="card-body">

                <!-- Session Name-->
                <div class="text-center mb-5">
                    <p class="lead">Session Name</p>
                    <div class="p-3 border rounded bg-light">
                        <textarea asp-for="Name"
                                  class="form-control"
                                  placeholder="Enter Name of your session. (Required)"
                                  style="min-height: 50px; border: none; background: transparent;"></textarea>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <!-- Session Notes-->
                <div class="text-center mb-5">
                    <p class="lead">Session Notes</p>
                    <div class="p-3 border rounded bg-light">
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  placeholder="Enter session notes(optional)"
                                  style="min-height: 150px; border: none; background: transparent;"></textarea>

                    </div>
                </div>

                <div class="text-center mb-5">
                    <h5>Map Selection</h5>
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px; width: 100%;">
                        <!-- No Select Map Functions Available yet, just showing default dunction until later.-->
                        <p>Default Dungeon Map will be assigned</p>
                    </div>
                </div>

                <div class="d-grid gap-2 col-6 mx-auto">
                    <button type="submit" class="btn btn-success btn-lg">
                        Create Session
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </div>
        </form>

        <div class="card-footer text-muted text-center mt-4">
            Created on: @DateTime.Now.ToString("f")
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</body>