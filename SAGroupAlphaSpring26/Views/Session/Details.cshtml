@model SAGroupAlphaSpring26.Models.Session

@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Name) ? $"Session {Model.Id}" : Model.Name;
}

<div class="main-content">
    <form asp-action="Edit" asp-controller="Session" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="text-center mb-5 header">
            <h1 class="mb-0">Session Details</h1>
            <hr class="w-25 mx-auto" />

            <input asp-for="Name"
                   class="display-4 fw-bold text-center border-0 bg-transparent w-100"
                   placeholder="Session @Model.Id" />
        </div>

        <div class="card">
            <div class="card-body">
                <div class="text-center">
                    <p class="lead">Notes</p>
                    <div class="session-notes">
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  placeholder="Write Notes Here..."
                                  style="min-height: 150px; border: none; background: transparent;"></textarea>
                    </div>
                </div>

                <div class="text-center mb-5">
                    @await Component.InvokeAsync("MapPreview", new { sessionId = Model.Id })
                </div>

                <div class="row justify-content-center g-3 col-8 mx-auto">
                    <div class="col-md-6">
                        <button type="submit" class="button-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-save me-2"></i> Save Changes
                        </button>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Map"
                               asp-action="MapTest"
                               asp-route-id="@Model.Id"
                               class="button-success btn-lg w-100 shadow-sm d-inline-block">
                            Launch Session
                        </a>
                    </div>
                </div>
            </div>
            </div>
        </form>
    
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <form asp-action="Delete" asp-controller="Session" asp-route-id="@Model.Id" method="post">
                        <button type="submit"
                                class="button-danger btn-sm w-100 shadow-sm"
                                onclick="return confirm('Are you sure you want to delete this session? This action can be undone.');">
                            <i class="bi bi-trash me-2"></i> Delete Session
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <div class="card-footer text-muted text-center mt-4">
        Last Updated: @Model.LastUpdated.ToString("f")
    </div>
