@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="p-4">
    <h1 class="mb-4">📜 Privacy Policy (Adventurer Edition)</h1>

    <div class="card p-4 shadow">

        <p><strong>Welcome, Dungeon Master.</strong></p>

        <p>
            This realm is primarily a <strong>map tool for tabletop games</strong>.
            We keep things simple and only collect what’s needed to keep your campaigns running.
        </p>

        <hr />

        <h4>🧭 What we actually store</h4>
        <ul>
            <li>🗺️ Your saved maps and session data</li>
            <li>👤 Basic account information (if you create an account)</li>
            <li>🛒 Purchases from the store (for unlocking map pieces)</li>
        </ul>

        <p class="text-muted">
            We do <strong>not</strong> track your dice rolls, your party arguments,
            or your NPC voices… those are between you and your table.
        </p>

        <hr />

        <h4>💰 Store & Purchases</h4>
        <p>
            If you buy map assets, we store purchase information so you can keep using them.
            Payments are handled securely by third-party providers (no dragons involved).
        </p>

        <h4>🍪 Cookies</h4>
        <p>
            We may use basic cookies to keep you logged in and the app working properly.
            Sadly, still not the edible kind.
        </p>

        <h4>🛡️ Data Safety</h4>
        <p>
            Your maps and data are stored securely. We aim to protect them like a well-guarded treasure vault.
        </p>

        <h4>⚔️ Your Rights</h4>
        <p>
            You can request to view or delete your data at any time.
        </p>

        <hr />

        <p class="mt-4">
            <em>
                Questions? Contact support — no quest required.
            </em>
        </p>

    </div>
</section>