@* @model SAGroupAlphaSpring26.ViewModels.StoreViewModel *@
@model PaginatedPieceList

@{
    ViewData["Title"] = "Store Page";
}
<link rel="stylesheet" href="~/css/pages/store.css" asp-append-version="true" />

<div class="text-center justify-content-center" style="margin-bottom: 20px;">
    <h1>Welcome to @ViewBag.ApplicationName!</h1>

    <table>
        <tr>
            <th>
                @* @Html.ActionLink("Piece Name", "Store", new { sortOrder = ViewBag.SortOrder }) *@
                <!--                                                                  Setting the sort route (gets passed from controller)     Also keepin the filter route so user can do both. -->
                <p>Sort by: <a asp-controller="Home" asp-action="Store" asp-route-sortOrder='@ViewData["PriceSort"]' asp-route-filter='@Context.Request.Query["filter"]' asp-route-storeitemtype='@Context.Request.Query["storeitemtype"]'>Price</a></p>
            </th>
            <th>
                <p>Sort by: <a asp-controller="Home" asp-action="Store" asp-route-sortOrder='@ViewData["NameSort"]' asp-route-filter='@Context.Request.Query["filter"]' asp-route-storeitemtype='@Context.Request.Query["storeitemtype"]'>Name</a></p>
            </th>
        </tr>
        <tr>
            <td><partial name="_SearchPartial" /></td>
            <td><partial name="_SetsPiecePartial" /></td>
        </tr>
    </table>

    @* @if(Model.Sets.Count <= 0 && Model.Pieces.Count <= 0)
    {
        <p>Nothing seemed to have fit your filter(s), please modify your search.</p>
    }

    @if (Model.Sets.Count > 0)
    {
        <h1 style="margin-top: 20px">Sets</h1>
    }
    <div class="store-grid">
        @foreach (var set in Model.Sets)
        {
            decimal totalPrice = set.PiecesList?.Sum(ps => ps.Piece.Price) ?? 0m;
            <div class="store-item store-set-item">
                <h3>@set.Name</h3>
                <p>Pieces (@(set.PiecesList?.Count ?? 0)): @string.Join(", ", set.PiecesList?.Select(ps => ps.Piece.Name) ?? Enumerable.Empty<string>())</p>
                <p>Total: $@set.Price.ToString("F2")</p>
                <div>
                    <a class="button-primary" asp-controller="Home" asp-action="Set" asp-route-id="@set.Id">View</a>
                </div>
            </div>
        }
    </div> *@

     <!-- https://getbootstrap.com/docs/4.4/layout/grid/ --> 
        <div class="row row-cols-2 row-cols-md-4">
        @foreach (Piece piece in Model.PiecesList)
        {
            <div class="col">
                <!-- Updated the img src tag to include the /images folder. Added onerror so that the imagepath defaults to our placeholder image.-->
                <div class="store-item" style="margin: 5px;">
                    <!-- Sets the image path. | "onerror" sets image to default.png | this.onerror=null prevents infinite looping. -->
                    <img src="@piece.ImagePath" alt="@piece.Name"
                         onerror="this.onerror=null; this.src='/images/default.png';" />

                    <h3>@piece.Name</h3>
                    <p>@piece.Description</p>
                    <p>Price: $@piece.Price</p>
                    <!-- <button class="button-primary">View</button> -->
                    <div>
                        <a class="button-primary" asp-controller="Home" asp-action="Piece" asp-route-id="@piece.Id">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    private string GetTypeName(int typeId)
    {
        return typeId switch
        {
            1 => "Enemies",
            2 => "Maps",
            3 => "Characters",
            4 => "Shops & Interactables",
            _ => "Misc"
        };
    }
}

