@using System.Security.Claims
@using SAGroupAlphaSpring26.Data;
@using SAGroupAlphaSpring26.Services;
@model Set
<!-- This is how you dependency inject a cshtml-->
@inject DataContext dc;

@{
    bool setInCart = false;

    DataService dataService = new(dc);
    int userId = Convert.ToInt32(User.FindFirst(ClaimTypes.NameIdentifier)?.Value);

    var set = dataService.GetCartItemSet(userId, Model.Id);
    if(set != null)
    {
        setInCart = true;
    }

    bool userOwnsSet = true; // For this boolean I will just check if user owns all pieces in the set.

    foreach(PieceSets p in Model.PiecesList)
    {
        if (dataService.UserOwnsPiece(userId, p.PieceId) == false)
            userOwnsSet = false; // If they dont own one of the pieces they do not own the set...
    }
}

@if (Model != null)
{
    if (Model.PiecesList != null)
    {
        // Making a 2x2 grid for the pieces.
        for(int i = 0; i < Model.PiecesList.Count(); i++)
        {
            Piece piece = Model.PiecesList[i].Piece;

            if(i % 2 == 0)
            {
                @:<div class="row justify-content-center">
            }
            <div class="card col" style="margin: 15px; max-width: 25vw;">
                <img src="@piece.ImagePath" class="card-img-top" style="height: 10vh; width: auto; aspect-ratio: 16 / 9; object-fit: contain;" />
                <div class="card-body align-self-center">
                    <h5 class="card-title">@piece.Name</h5>
                    <p class="card-body">@piece.Description</p>
                    </div>
            </div>

             if(i % 2 == 1 || i == Model.PiecesList.Count() - 1)
            {
                // Then after two piece in the row close it.
                @:</div>
            }
        }

        
    <p class="text-center" style="background-color: #F5DEB3; font-size: 20px; width: auto;">
        Price: @Model.Price;
    </p>
    }

    @if (userOwnsSet)
    {
        <p>You already own this set.</p>
        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Store">Store</a>
    }
    else
    {
        <!-- We need to first check if the user has this item in their cart... If so do not let them add another to card. -->
        @if (!setInCart)
        {
            <form method="POST" asp-controller="cart" asp-action="addsettocart" asp-route-id="@Model.Id">
                <p>
                    <button type="submit" class="btn btn-primary" role="button">Add to cart</button>
                </p>
            </form>
        }
        else
        {
            <p>Set is already in your cart.</p>
            <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Store">Store</a>
        }
    }
}
else
{
    <p>No set with said ID</p>
}