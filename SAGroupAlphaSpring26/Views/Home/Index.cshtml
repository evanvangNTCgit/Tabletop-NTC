@model IEnumerable<Session>
@{
    ViewData["Title"] = "Home Page";
}
<section id="WelcomeSection" class="p-3">
    <div class="text-center mb-5 header">
        <h1>Welcome to @ViewBag.ApplicationName!</h1>
        <p class="lead">Select a session below to resume.</p>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="list-group shadow">
                        <!-- Loops Through the User's Sessions and Displays them-->
                        @foreach (var item in Model)
                        {
                            <a asp-controller="Session"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-4 m-1">

                                <div>
                                    <h5 class="mb-1">@item.Name</h5>
                                    <small class="text-muted">Last Updated: @item.LastUpdated.ToString("f")</small>
                                </div>

                                <span class="button-success">Session Details</span>
                            </a>
                        }
                    </div>
                </div>


                <a asp-controller="Session" asp-action="Create"
                       class="button-success btn-lg px-5 rounded-pill shadow">
                    <i class="bi bi-plus-circle me-2"></i> Create New Session
                </a>

                <div class="mt-3">

                    <div class="advanced-wrapper">
                        <button class="advanced-pill" onclick="this.parentElement.classList.toggle('open')">
                            Advanced Options
                        </button>

                        <div class="advanced-menu">
                            <a asp-controller="Session" asp-action="RecoverSession"
                                   class="restore-pill">
                                Restore Deleted Session
                            </a>
                        </div>
                    </div>

                </div>

            </div>
            @if (!Model.Any())
            {
                <div class="alert alert-info mt-4">
                    No sessions found. <a asp-controller="Session" asp-action="Create">Create a new one!</a>
                </div>
            }
        </div>
    </div>
</section>