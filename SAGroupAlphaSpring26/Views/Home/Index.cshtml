@model IEnumerable<Session>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1>Welcome to @ViewBag.ApplicationName!</h1>
    <p class="lead">Select a session below to resume.</p>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="list-group shadow">
                <!-- Loops Through the User's Sessions and Displays them-->
                @foreach (var item in Model)
                {
                    <a asp-controller="Session"
                       asp-action="Details"
                       asp-route-id="@item.Id"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-4">

                        <div>
                            <h5 class="mb-1 text-primary">@item.Name</h5>
                            <small class="text-muted">Last Updated: @item.LastUpdated.ToShortDateString()</small>
                        </div>

                        <span class="btn btn-success">Session Details</span>
                    </a>
                }
            </div>


                <a asp-controller="Session" asp-action="Create"
                   class="btn btn-success btn-lg px-5 rounded-pill shadow">
                    <i class="bi bi-plus-circle me-2"></i> Create New Session
                </a>

        </div>
            @if (!Model.Any())
            {
                <div class="alert alert-info mt-4">
                    No sessions found. <a asp-controller="Session" asp-action="Create">Create a new one!</a>
                </div>
            }
        </div>
    </div>
</div>