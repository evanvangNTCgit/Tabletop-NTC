@using System.Security.Claims
@using SAGroupAlphaSpring26.Data;
@using SAGroupAlphaSpring26.Services;
@model Piece

<!-- This is how you dependency inject a cshtml-->
@inject DataContext dc;

@{
    bool pieceInCart = false;
    bool setInCartContainsPiece = false;

    DataService dataService = new(dc);
    int userId = Convert.ToInt32(User.FindFirst(ClaimTypes.NameIdentifier)?.Value);

    var piece = dataService.GetCartItem(userId, Model.Id);
    if (piece != null)
    {
        pieceInCart = true;
    }

    var usersSetsInCart = dataService.GetCartItemSet(userId);
    // Okay so loop and see if the current piece is already in a set that they have in cart currently.
    foreach(CartItemSet set in usersSetsInCart)
    {
        foreach(PieceSets p in set.Set!.PiecesList!)
        {
            if (p.PieceId == Model.Id)
                setInCartContainsPiece = true;
        }
    }
    bool userOwnsPiece = dataService.UserOwnsPiece(userId, Model.Id);
}

@if(Model != null)
{
    <section class="text-center" style="background-color: #F5DEB3;">
        <h1>@Model.Name</h1>
        <img class="img-fluid pieceStoreImg" src=" @Model.ImagePath" alt="@Model.Name">
        <p style="font-size: 20px;">@Model.Description</p>
        <p style="font-size: 20px;">Price: $@Model.Price</p>
    </section>
    @if (userOwnsPiece)
    {
        <p>You already own this piece.</p>
        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Store">Store</a>
    }
    else
    {
        @if (setInCartContainsPiece)
        {
            <p class="text-warning" style="background-color: black; padding: 1px;">You already have a set in your cart that contains this piece.</p>
            <form method="POST" asp-controller="cart" asp-action="addtocart" asp-route-id="@Model.Id">
                <p>
                    <button type="submit" class="btn btn-primary" role="button">Add to cart</button>
                </p>
            </form>
        }
        else if (!pieceInCart)
        {
            <form method="POST" asp-controller="cart" asp-action="addtocart" asp-route-id="@Model.Id">
                <p>
                    <button type="submit" class="btn btn-primary" role="button">Add to cart</button>
                </p>
            </form>
        }
        else
        {
            <p>This piece is already in your cart.</p>
            <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Store">Store</a>
        }
    }
} else
{
    <p>No piece with said ID</p>
}