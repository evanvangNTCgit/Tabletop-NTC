﻿<form method="GET" asp-controller="Home" asp-action="Store" class="form-inline my-2 my-lg-0">


    <div class="input-group">
        <input name="filter" class="form-control" value='@Context.Request.Query["filter"]' />
        <input type="hidden" name="sortOrder" value='@Context.Request.Query["sortOrder"]' class="w-100" />
        <input type="hidden" name="storeitemtype" value='@Context.Request.Query["storeitemtype"]' class="w-100" />


        <input type="hidden" name="pageNumber" value='@Context.Request.Query["pageNumber"]' class="w-100" />

        <div class="input-group-append">
            <input type="submit" value="Search" class="btn btn-primary" />
        </div>
    </div>
</form>