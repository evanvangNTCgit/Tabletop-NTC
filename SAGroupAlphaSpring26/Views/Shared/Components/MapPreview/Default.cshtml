@model IEnumerable<SAGroupAlphaSpring26.Models.Token>

@{
    var mapToken = Model.FirstOrDefault(t => t.Piece?.PieceType?.Name == "Map");
    var activeTokens = Model.Where(t => t.Piece?.PieceType?.Name != "Map").ToList();
}

<div class="text-start">
    <div class="d-flex justify-content-between align-items-center" 
         style="cursor: pointer; user-select: none;" 
         data-bs-toggle="collapse" 
         data-bs-target="#tokenCollapse" 
         aria-expanded="false">
        <h5 class="">
            <i class="bi bi-chevron-right transition-icon" style="font-size: 0.9rem;"></i> Tokens
        </h5>
        <span class="badge text-black">@activeTokens.Count Token(s)</span>
    </div>
 

    <div id="tokenCollapse" class="collapse">
        <div class="card-body saBackground">
            @if (activeTokens.Any())
            {
                <div class="saBackground2">
                    @foreach (var token in activeTokens.OrderByDescending(t => t.ZIndex))
                    {
                        var tokenName = string.IsNullOrEmpty(token.Name) ? (token.Piece?.Name ?? "Unknown Piece") : token.Name;
                        var imagePath = token.Piece?.ImagePath ?? "/images/default.png";
                        var isVisible = token.Visibility;

                        <div class="list-group-item list-group-item-action d-flex align-items-start">
                            <img src="@imagePath" alt="@tokenName" class="rounded border border-warning" style="width: 50px; height: 50px; object-fit: contain;" />
                            <div class="">
                                <div class="d-flex w-100 justify-content-between">
                                    <h5 class="">
                                        @tokenName
                                        @if (!isVisible)
                                        {
                                            <span class="badge bg-danger ms-2"><i class="bi-eye-slash"></i> Hidden</span>
                                        }
                                    </h5>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(token.Notes))
                                {
                                    <p class="mb-1 text-muted small fst-italic">"@token.Notes"</p>
                                }
                                else
                                {
                                    <p class="mb-1 text-muted small fst-italic">No notes attached.</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-4 text-muted bg-dark">
                    <i class="bi bi-inbox fs-1 mb-2"></i>
                    <p class="mb-0">No active tokens dropped on map</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    [aria-expanded="true"] .transition-icon {
        transform: rotate(90deg);
    }
    .transition-icon {
        display: inline-block;
        transition: transform 0.2s ease-in-out;
        margin-right: 5px;
    }
</style>


