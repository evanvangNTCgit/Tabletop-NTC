﻿<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Northcentral Technical College Interactive Tabletop Map</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SAGroupAlphaSpring26.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/jqueryui/themes/base/jquery-ui.css" />
</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
            NTC Tabletop Map
        </a>

        <ul class="nav-list">
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <li>
                    <a class="nav-button signin" asp-area="" asp-controller="Account" asp-action="Login">
                        Sign In
                    </a>
                </li>
            }
            <li>
                <a class="nav-button" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li>
                <a class="nav-button" asp-area="" asp-controller="Home" asp-action="Store">Store</a>
            </li>

            <vc:cart></vc:cart>
            @* removed for the above view component ^
            <li>
                <a class="nav-button" asp-area="" asp-controller="Cart" asp-action="view">Cart</a>
            </li> *@

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="nav-button logout">Logout</button>
                    </form>
                </li>
            }

            <!-- If user is logged in and is an admin... -->
            @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
            {
                <div class="user-greeting">Hello, @User.Identity.Name</div>

                <div class="admin-section">
                    <div class="dropdown">
                        <a class="admin-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="adminDropdown">
                            <span>Admin</span> <i class="bi bi-caret-down-fill"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                            <li>
                                <a asp-controller="Admin" asp-action="Pieces" class="dropdown-item" role="button">Pieces</a>
                            </li>
                            <li>
                                <a asp-controller="Admin" asp-action="PieceTypes" class="dropdown-item" role="button">Piece Types</a>
                            </li>
                            <li>
                                <a asp-controller="Admin" asp-action="Sets" class="dropdown-item" role="button">Sets</a>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted" id="Footer">
        <div class="container">
            &copy; @DateTime.Now.Year - SAGroupAlphaSpring26 - <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: #60a5fa;">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jqueryui/jquery-ui.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
