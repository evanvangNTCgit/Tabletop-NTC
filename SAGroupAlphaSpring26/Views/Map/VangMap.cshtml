@model SAGroupAlphaSpring26.ViewModels.MapScreenViewModel

<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<link rel="stylesheet" href="~/css/map-general.css" asp-append-version="true" />

<div class="map-toolbar">
    <div class="toolbar-group">
        <button id="btn-undo" class="button-primary" disabled title="Undo"><i class="bi bi-arrow-counterclockwise"></i></button>
        <button id="btn-redo" class="button-primary" disabled title="Redo"><i class="bi bi-arrow-clockwise"></i></button>
        <button id="btn-save" class="button-primary" title="Save Positions"><i class="bi bi-save"></i> Save</button>
        <button id="btn-clear-board" class="button-danger ms-1" title="Clear Board"><i class="bi bi-eraser"></i> Clear</button>
        <select id="map-select" class="button-primary ms-2">
            <option value="">-- Change Map --</option>
            @foreach (var piece in Model.PlayablePieces.Where(p => p.PieceType?.Name == "Map"))
            {
                <option value="@piece.Id">@piece.Name</option>
            }
        </select>
        <a id="btn-cancel" asp-controller="Home" asp-action="Index" class="button-primary ms-2">Cancel</a>
    </div>

<!-- 
    Contains the buttons and dropdown for changing the scene.
-->
    <div class="toolbar-group">
        <select id="scene-select" class="button-primary">
            @foreach (var scene in Model.Scenes)
            {
                <option value="@scene.Id" selected="@(Model.CurrentScene?.Id == scene.Id ? "selected" : null)">@scene.Name</option>
            }
        </select>
        <button id="btn-add-scene" class="button-primary ms-1" title="New Scene"><i class="bi bi-plus-circle"></i></button>
        <button id="btn-delete-scene" class="button-danger ms-1" title="Delete Current Scene"><i class="bi bi-trash"></i></button>
    </div>

    <div class="toolbar-group">
        <button id="btn-toggle-token-info" class="button-primary">Token Info</button>
        <button id="btn-toggle-notes" class="button-primary">Session Notes</button>
        <button id="btn-toggle-delete" class="button-primary" title="Toggle Token Delete Area"><i class="bi bi-trash"></i> Token Delete Area</button>
        <a asp-controller="Map"
               asp-action="Playerview"
               target="_blank"
               asp-route-id="@Model.CurrentSession.Id"
               class="button-success player-view-btn">
            Player View
        </a>
    </div>
</div>

@* I created a wrapper div for the map and piece bar. *@

<div class="map-layout-wrapper map-container" style="--zoom: 1; transform: scale(var(--zoom));">

    @* I moved the piece bar before the map board. *@
    <div class="piece-bar">
        <h4 class="collection-header">Collection</h4>
        <div class="token-list">
            @foreach (var piece in Model.PlayablePieces)
            {
                // Image Paths currently /images/Cleric.png
                // However must be ~/images/(filename).

                // I assume we dont want he user to get a map?
                if (piece.PieceType!.Name == "Map")
                {
                    continue;
                }

                String realImagePath = $"{piece.ImagePath}";

                 <img src="@realImagePath"
                      class="map-piece sidebar-piece"
                      draggable="true"
                      data-pieceid="@piece.Id.ToString()"
                      data-piecename="@piece.Name"
                      alt="@piece.Name"
                      onerror="this.onerror=null; this.src='/images/default.png';" />
            }
        </div>
    </div>

    <!-- https://stackoverflow.com/questions/26438388/maintain-div-aspect-ratio-according-to-height -->
        <div class="map-container vang-map-board"
             id="map-board"
             data-role="dm">

             <img src="@Model.MapImagePath" class="vang-map-bg-image"/>

            @foreach (var token in Model.Tokens.Where(t => t.Piece?.PieceType?.Name != "Map"))
            {
                    <img src="@(string.IsNullOrEmpty(token.Piece?.ImagePath) ? "/images/BetaMap1.png" : token.Piece.ImagePath)"
                         class="draggable-token @(!token.Visibility ? "dmOpacityToggle" : "")"
                         style="left: @(token.X)%; top: @(token.Y)%; z-index: @token.ZIndex;"
                         id="token-placed-@token.Id"
                         data-tokenid="@token.Id"
                         data-pieceid="@token.PieceID"
                         data-piecename="@(token.Piece?.Name ?? "")"
                         data-name="@(string.IsNullOrEmpty(token.Name) ? (token.Piece?.Name ?? "") : token.Name)"
                         data-notes="@(token.Notes)"
                         data-visibility="@token.Visibility.ToString().ToLower()"
                         onerror="this.onerror=null; this.src='/images/default.png';" />
            }

        @* Drag tokens into this area to delete them. Initially hidden. *@
        <div id="delete-area" class="delete-drop-zone" style="display: none;">
            <p>Drop to Remove</p>
        </div>
        </div>

    @* Token Information Panel *@
    <div class="token-info-panel" id="token-info-panel">
        <h4 class="token-info-header">Token Info</h4>
        
        <div class="token-info-content">
            <div class="token-info-image-container">
                <img id="token-info-image" src="" alt="Token Graphic" />
            </div>

            <div>
                <label for="token-info-name" class="token-info-label">Name:</label>
                <input type="text" id="token-info-name" class="form-control token-info-input" />
            </div>

            <div>
                <label for="token-info-zindex" class="token-info-label">Z-Index:</label>
                <input type="number" id="token-info-zindex" min="0" class="form-control token-info-input" />
            </div>

            <div>
                <label for="token-info-notes" class="token-info-label">Notes:</label>
                <textarea id="token-info-notes" class="form-control token-info-input token-info-textarea"></textarea>
            </div>

            <div class="token-info-checkbox-container">
                <label for="token-info-visibility" class="token-info-checkbox-label">Is Visible:</label>
                <input type="checkbox" id="token-info-visibility" class="token-info-checkbox"/>
            </div>

            <div class="token-info-button-container">
                <button id="token-info-delete" class="btn btn-danger token-info-delete-btn">Delete Token</button>
            </div>
        </div>
    </div>

    @* Session Notes Panel *@
    <div class="session-notes-panel" id="session-notes-panel">
        <h4 class="token-info-header">Session Notes</h4>
        <div class="token-info-content session-notes-content">
            <textarea id="session-notes-textarea" class="session-notes-textarea">@Model.CurrentSession?.Notes</textarea>
            
            <div class="token-info-button-container">
                <button id="btn-save-notes" class="btn btn-success btn-save-notes"><i class="bi bi-journal-check"></i> Save Notes</button>
            </div>
        </div>
    </div>

    @* Scene Wizard Modal, used for Managing/Creating Scenes *@
    <div class="modal-overlay" id="scene-wizard-overlay">
        <div class="scene-wizard-modal">
            <h2 class="modal-title">Create New Scene</h2>
            
            <div class="modal-section">
                <label for="wizard-scene-name">Scene Name</label>
                <input type="text" id="wizard-scene-name" class="modal-input" placeholder="e.g. Boss Room, Forest Clearing..." />
            </div>

            <div class="modal-section">
                <label for="wizard-map-select">Background Map</label>
                <select id="wizard-map-select" class="modal-input">
                    <option value="">Select a map...</option>
                    @foreach (var piece in Model.PlayablePieces.Where(p => string.Equals(p.PieceType?.Name, "Map", StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@piece.Id">@piece.Name</option>
                    }
                </select>
            </div>

            <div class="modal-section">
                <label>Copy Tokens To New Scene?</label>
                <div class="token-clone-list">
                    <div class="token-clone-item" style="border-bottom: 1px solid #333; position: sticky; top: 0; z-index: 10; background: rgba(20, 20, 20, 0.95);">
                        <input type="checkbox" id="wizard-select-all" />
                        <label for="wizard-select-all" style="font-weight: bold; cursor: pointer;">Select All Tokens</label>
                    </div>
                    @foreach (var token in Model.Tokens.Where(t => !string.Equals(t.Piece?.PieceType?.Name, "Map", StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="token-clone-item">
                            <input type="checkbox" class="token-clone-checkbox" value="@token.Id" id="clone-@token.Id" />
                            <label for="clone-@token.Id">
                                @if (!string.IsNullOrEmpty(token.Piece?.ImagePath))
                                {
                                    <img src="@token.Piece.ImagePath" style="width: 24px; height: 24px; border-radius: 4px; margin-right: 5px;" />
                                }
                                @token.Name
                            </label>
                        </div>
                    }
                    @if (!Model.Tokens.Any(t => !string.Equals(t.Piece?.PieceType?.Name, "Map", StringComparison.OrdinalIgnoreCase)))
                    {
                        <div style="color: #666; font-style: italic; padding: 10px; text-align: center;">No tokens available to copy.</div>
                    }
                </div>
            </div>

            <div class="modal-actions">
                <button id="btn-wizard-cancel" class="btn-wizard-cancel">Cancel</button>
                <button id="btn-wizard-create" class="btn-wizard-create">Create Scene</button>
            </div>
        </div>
    </div>

    @* Switch Confirmation Modal *@
    <div class="modal-overlay" id="switch-confirm-overlay">
        <div class="scene-wizard-modal" style="width: 400px;">
            <h2 class="modal-title">Unsaved Changes</h2>
            <p style="text-align: center; color: #f4e4bc; margin-bottom: 1.5rem;">You have unsaved changes on this board. What would you like to do before switching scenes?</p>
            
            <div class="modal-section" style="gap: 1rem;">
                <button id="btn-switch-save" class="btn-wizard-create" style="width: 100%;">Save and Switch</button>
                <button id="btn-switch-nosave" class="btn-wizard-cancel" style="width: 100%; border-color: #D4AF37; color: #D4AF37;">Switch Without Saving</button>
                <button id="btn-switch-cancel" class="btn-wizard-cancel" style="width: 100%;">Cancel (Stay Here)</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts start here -->
@section Scripts {
    <script>
        window.sessionId = @Json.Serialize(Model.CurrentSession.Id);
        window.currentSceneId = @Json.Serialize(Model.CurrentScene?.Id);
    </script>
    <!--Replaced with map.js module-->
    <script type="module" src="~/js/map.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const footer = document.getElementById('Footer');
            if (footer) footer.style.display = 'none';
        });
    </script>
}

