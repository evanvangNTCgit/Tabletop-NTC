@model SAGroupAlphaSpring26.ViewModels.MapScreenViewModel

<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<link rel="stylesheet" href="~/css/map-general.css" asp-append-version="true" />

<div class="map-toolbar">
    <div class="toolbar-group">
        <button id="btn-save" class="button-primary">Save Changes</button>
        <a asp-controller="Home" asp-action="Index" class="button-primary">Cancel</a>
    </div>

    <div class="toolbar-group">
        <button id="btn-toggle-token-info" class="button-primary">Token Info</button>
        <button id="btn-toggle-notes" class="button-primary">Session Notes</button>
        <a asp-controller="Map"
               asp-action="Playerview"
               target="_blank"
               asp-route-id="@Model.CurrentSession.Id"
               class="button-success player-view-btn">
            Player View
        </a>
    </div>
</div>

@* I created a wrapper div for the map and piece bar. *@

<div class="map-layout-wrapper map-container" style="--zoom: 1; transform: scale(var(--zoom));">

    @* I moved the piece bar before the map board. *@
    <div class="piece-bar">
        <h4 class="collection-header">Collection</h4>
        <div class="token-list">
            @foreach (var piece in Model.PlayablePieces)
            {
                // Image Paths currently /images/Cleric.png
                // However must be ~/images/(filename).

                // I assume we dont want he user to get a map?
                if (piece.PieceType!.Name == "Map")
                {
                    continue;
                }

                String realImagePath = $"{piece.ImagePath}";

                 <img src="@realImagePath"
                      class="map-piece sidebar-piece"
                      draggable="true"
                      data-pieceid="@piece.Id.ToString()"
                      data-piecename="@piece.Name"
                      alt="@piece.Name"
                      onerror="this.onerror=null; this.src='/images/default.png';" />
            }
        </div>
    </div>

    <!-- https://stackoverflow.com/questions/26438388/maintain-div-aspect-ratio-according-to-height -->
        <div class="map-container vang-map-board"
             id="map-board"
             data-role="dm">

             <img src="@Model.MapImagePath" class="vang-map-bg-image"/>

            @foreach (var token in Model.Tokens.Where(t => t.Piece?.PieceType?.Name != "Map"))
            {
                    <img src="@(string.IsNullOrEmpty(token.Piece?.ImagePath) ? "/images/BetaMap1.png" : token.Piece.ImagePath)"
                         class="draggable-token @(!token.Visibility ? "dmOpacityToggle" : "")"
                         style="left: @(token.X)%; top: @(token.Y)%; z-index: @token.ZIndex;"
                         id="token-placed-@token.Id"
                         data-tokenid="@token.Id"
                         data-pieceid="@token.PieceID"
                         data-piecename="@(token.Piece?.Name ?? "")"
                         data-name="@(string.IsNullOrEmpty(token.Name) ? (token.Piece?.Name ?? "") : token.Name)"
                         data-notes="@(token.Notes)"
                         data-visibility="@token.Visibility.ToString().ToLower()"
                         onerror="this.onerror=null; this.src='/images/default.png';" />
            }

        @* Drag tokens into this area to delete them. *@
        <div id="delete-area" class="delete-drop-zone">
            <p>Drop to Remove</p>
        </div>
        </div>

    @* Token Information Panel *@
    <div class="token-info-panel" id="token-info-panel">
        <h4 class="token-info-header">Token Info</h4>
        
        <div class="token-info-content">
            <div class="token-info-image-container">
                <img id="token-info-image" src="" alt="Token Graphic" />
            </div>

            <div>
                <label for="token-info-name" class="token-info-label">Name:</label>
                <input type="text" id="token-info-name" class="form-control token-info-input" />
            </div>

            <div>
                <label for="token-info-zindex" class="token-info-label">Z-Index:</label>
                <input type="number" id="token-info-zindex" min="0" class="form-control token-info-input" />
            </div>

            <div>
                <label for="token-info-notes" class="token-info-label">Notes:</label>
                <textarea id="token-info-notes" class="form-control token-info-input token-info-textarea"></textarea>
            </div>

            <div class="token-info-checkbox-container">
                <label for="token-info-visibility" class="token-info-checkbox-label">Is Visible:</label>
                <input type="checkbox" id="token-info-visibility" class="token-info-checkbox"/>
            </div>

            <div class="token-info-button-container">
                <button id="token-info-delete" class="btn btn-danger token-info-delete-btn">Delete Token</button>
            </div>
        </div>
    </div>

    @* Session Notes Panel *@
    <div class="session-notes-panel" id="session-notes-panel">
        <h4 class="token-info-header">Session Notes</h4>
        <div class="token-info-content" style="flex-grow: 1; gap: 5px;">
            <textarea id="session-notes-textarea" class="session-notes-textarea">@Model.CurrentSession?.Notes</textarea>
            
            <div class="token-info-button-container">
                <button id="btn-save-notes" class="btn btn-success" style="width: 100%;">Save Notes</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts start here -->
@section Scripts {
    <script>
        window.sessionId = @Json.Serialize(Model.CurrentSession.Id);
    </script>
    <!--Replaced with map.js module-->
    <script type="module" src="~/js/map.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const footer = document.getElementById('Footer');
            if (footer) footer.style.display = 'none';
        });
    </script>
}

