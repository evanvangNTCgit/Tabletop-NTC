@{
    Layout = "_PlayerLayout";
}

@model SAGroupAlphaSpring26.ViewModels.MapScreenViewModel
<link rel="stylesheet" href="~/css/map-general.css" asp-append-version="true" />

@* Removed the for each loop, the playerview should draw from the tokens currently on the DM view map, not from whatever is saved in the database. *@
<div class="map-container"
     id="map-board"
     style="position: relative; justify-self: center; max-height: 90vh; max-width:90vh; overflow: hidden;"
     data-role="player">

    <img src="@Model.MapImagePath" style="width: 100%; height: auto; display: block;" />

</div>

<!-- Scripts start here -->
@section Scripts {
    <script>
        window.sessionId = @Json.Serialize(Model.CurrentSession?.Id ?? 0);
    </script>
    @* uses a module now. *@
    <script src="~/js/map.js" type="module"></script>

}

