@{
    Layout = "_PlayerLayout";
}

@model SAGroupAlphaSpring26.ViewModels.MapScreenViewModel

<div class="map-container"
     id="map-board"
     style="position: relative; justify-self: center; max-height: 70vh;"
     data-role="player">
    <img src="@Model.MapImagePath" style="width: 100%; height: auto; display: block;" />

    @foreach (var token in Model.Tokens.Where(t => t.Piece?.PieceType?.Name != "Map" && (t.X != 0 || t.Y != 0)))
    {
        <img src="@(string.IsNullOrEmpty(token.Piece?.ImagePath) ? "/images/default.png" : token.Piece.ImagePath)"
             class="draggable-token"
             style="width: 5%; height: 5%; position: absolute; top: 10%; left: 10%;"
             id="token-placed-@token.Id"
             data-tokenid="@token.Id"
             data-invisiblity="@token.Visibility"
             onerror="this.onerror=null; this.src='/images/default.png';" />
    }
</div>

<!-- Scripts start here -->
@section Scripts {
    <script>
        window.sessionId = @Json.Serialize(Model.CurrentSession.Id);
    </script>
    <script src="~/js/PlayerMapFunctions.js" type="module"></script>
    <script src="~/js/Vang.js" type="module"></script>

}

