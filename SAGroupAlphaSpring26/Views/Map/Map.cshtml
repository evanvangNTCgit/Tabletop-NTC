@model SAGroupAlphaSpring26.ViewModels.MapScreenViewModel

<div class="map-container" >

    <div class="piece-bar">
        <h4 style="color: white; padding: 10px; font-size: 0.9rem;">Collection</h4>
        <div class="token-list">
            @foreach(var piece in Model.PlayablePieces ?? new List<SAGroupAlphaSpring26.Models.Piece>()) // now creates new list if no pieces are found. Gets rid of the possible null warning. This should nevver happen, but in theory could.
            {
                // Image Paths currently /images/Cleric.png
                // However must be ~/images/(filename).

                // I assume we dont want he user to get a map?
                if(piece.PieceType!.Name == "Map")
                {
                    continue;
                }

                String realImagePath = $"{piece.ImagePath}";

                <img src="@realImagePath"
                     class="map-piece sidebar-piece"
                     draggable="true"
                     data-pieceid="@piece.Id.ToString()"
                     alt="@piece.Name"
                     onerror="this.onerror=null; this.src='/images/default.png';" />
            }
        </div>
    </div>

    <div class="map-main-area">

        <div class="map-toolbar">
            <div class="zoom-controls">
                <button id="zoom-in" class="zoom-btn button-primary">+</button>
                <button id="zoom-out" class="zoom-btn">-</button>
                <span id="zoom-level" style="font-size: 0.9rem; margin: 0 10px;">1x</span>
                <button id="zoom-reset" class="zoom-btn button-primary">1 : 1</button>
            </div>
            <button id="btn-undo" class="button-primary" disabled title="Undo"><i class="bi bi-arrow-counterclockwise"></i></button>
            <button id="btn-redo" class="button-primary" disabled title="Redo"><i class="bi bi-arrow-clockwise"></i></button>
            <button id="btn-save" class="button-primary" title="Save Positions"><i class="bi bi-save"></i> Save Positions</button>
            <a asp-controller="Home" asp-action="Index" class="button-primary" target="_blank">Cancel</a>
            <!--added ?? 0 to get rid of the null warning.-->
            <a asp-controller="Map"
                   asp-action="Playerview"
                   target="_blank"
                   asp-route-id="@Model.CurrentSession?.Id ?? 0" 
                   class="btn btn-success btn-lg w-100 shadow-sm">
                Player View
            </a>
        </div>

        <div class="map-board" id="map-board" style="background-image: url('@Model.MapImagePath'); background-size: contain; background-position: center;" data-role="dm">
            <!-- Added ?? Enumerable.Empty<SAGroupAlphaSpring26.Models.Token>() to get rid of the null warning. -->
            @foreach (var token in Model.Tokens?.Where(t => t.Piece?.PieceType?.Name != "Map" && (t.X != 0 || t.Y != 0)) ?? Enumerable.Empty<SAGroupAlphaSpring26.Models.Token>())
            {
                <img src="@(string.IsNullOrEmpty(token.Piece?.ImagePath) ? "/images/default.png" : token.Piece.ImagePath)"
                     class="map-piece draggable-token"
                     style="position: absolute; left: @(token.X)px; top: @(token.Y)px; z-index: @(token.ZIndex);"
                     id="token-placed-@token.Id"
                     data-tokenid="@token.Id"
                     onerror="this.onerror=null; this.src='/images/default.png';" />
            }
        </div>
    </div>
</div>

<!-- Scripts start here -->

@section Scripts {
    <script>
    // Added ?? 0 to get rid of the null warning. We should setup a landing page or redirect for the case that SessionID = 0 (null).
        window.sessionId = @Json.Serialize(Model.CurrentSession?.Id ?? 0);
    </script>
<script src="~/js/map.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const footer = document.getElementById('Footer');
            if (footer) footer.style.display = 'none';
        });
    </script>
}

