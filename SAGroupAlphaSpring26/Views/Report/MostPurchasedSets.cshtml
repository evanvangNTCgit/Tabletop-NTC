@model List<SetStatsViewModel>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        @if(item.Set != null)
        {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@item.Set.Name</h5>
                    <p class="card-text text-muted">
                        Total Purchased: <strong>@item.TotalPurchased</strong>
                    </p>
                </div>
            </div>
        </div>
        }
    }
</div>