@model List<PurchaseStatsViewModel>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@item.Piece.Name</h5>
                    <img class="card-img-top set-card-img" src="@item.Piece.ImagePath" />
                    <p class="card-text text-muted">
                        Total Purchased: <strong>@item.TotalPurchased</strong>
                    </p>
                    <p class="card-text text-muted">
                        Purchased in a set <strong>@item.</strong>
                    </p>
                </div>
            </div>
        </div>
    }
</div>