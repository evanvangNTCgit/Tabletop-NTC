@model SetViewModel
@{
    ViewData["Title"] = "Add Set";
}

<h2>Add New Set</h2>

<div class="form-horizontal">
    <form asp-action="AddSet" method="post">
        <div class="form-group">
            <label asp-for="NewSet.Name">Set Name</label>
            <input asp-for="NewSet.Name" class="form-control" />
            <span asp-validation-for="NewSet.Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewSet.Price">Price</label>
            <input asp-for="NewSet.Price" class="form-control" />
            <span asp-validation-for="NewSet.Price" class="text-danger"></span>
        </div>
        <br />
        <h4>Select Pieces for this Set</h4>
        <div class="row">
            @foreach (var piece in Model.AvailablePieces)
            {
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <img src="@piece.ImagePath" class="card-img-top add-piece-image" alt="@piece.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@piece.Name</h5>
                            <p class="card-text">@piece.PieceType?.Name | $@piece.Price</p>
                            <div class="form-check">
                                <input type="checkbox" 
                                       class="form-check-input" 
                                       name="SelectedPieceIds" 
                                       id="piece_@piece.Id"
                                       value="@piece.Id"
                                       @(Model.SelectedPieceIds.Contains(piece.Id) ? "checked" : "") />
                                <label class="form-check-label" for="piece_@piece.Id">
                                    Add to Set
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <button type="submit" class="btn btn-primary mt-3">Create Set</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
