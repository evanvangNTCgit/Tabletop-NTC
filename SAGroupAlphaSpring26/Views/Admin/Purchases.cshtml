@model List<SAGroupAlphaSpring26.ViewModels.PurchaseStatsViewModel>

@{
    ViewData["Title"] = "Purchase Statistics";
}

<h1>Purchase Statistics</h1>
<p>This view shows all pieces and how many times they have been purchased across all sales.</p>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped admin-table saBackground">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Total Purchased</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.Piece.ImagePath" alt="@item.Piece.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                        </td>
                        <td>
                            <a asp-controller="Home" asp-action="Piece" asp-route-id="@item.Piece.Id">@item.Piece.Name</a>
                        </td>
                        <td>@item.Piece.PieceType?.Name</td>
                        <td><strong>@item.TotalPurchased</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No purchases found yet.</p>
}
