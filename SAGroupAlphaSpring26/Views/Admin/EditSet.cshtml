@model EditSetViewModel
<div class="saBackground">
    <h2>Update Piece Type</h2>
</div>
<div class="form-horizontal">
    <form method="post">
        <input type="hidden" asp-for="SetToEdit.Id"/>
        <div asp-validation-summary="All" class="bg-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="SetToEdit.Name"></label>
            <input asp-for="SetToEdit.Name" class="form-control" />
            <span asp-validation-for="SetToEdit.Name" class="bg-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="SetToEdit.Price"></label>
            <input asp-for="SetToEdit.Price" class="form-control" />
            <span asp-validation-for="SetToEdit.Price" class="bg-danger"></span>
        </div>
        <div class="row">
            @foreach (Piece piece in Model.PiecesAvailable)
            {
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <img src="@piece.ImagePath" class="card-img-top add-piece-image" alt="@piece.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@piece.Name</h5>
                            <p class="card-text">@piece.PieceType?.Name | $@piece.Price</p>
                            <div class="form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       name="SelectedPieceIds"
                                       id="piece_@piece.Id"
                                       value="@piece.Id"
                                @(Model.SelectedPieceIds.Contains(piece.Id) ? "checked" : "") />
                                <label class="form-check-label" for="piece_@piece.Id">
                                    Add to Set
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <p>
            <button type="submit" class="btn btn-primary" role="button">Save</button>
        </p>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}