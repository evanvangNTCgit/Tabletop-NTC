@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Admin Dashboard</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Add Piece</h5>
                <p class="card-text">Add new pieces to the store.</p>
                <a asp-action="AddPiece" class="btn btn-primary">Go</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Add Piece Type</h5>
                <p class="card-text">Add new piece types (Player, Monster, etc.).</p>
                <a asp-action="AddPieceType" class="btn btn-primary">Go</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Add Set</h5>
                <p class="card-text">Create sets and add pieces to them.</p>
                <a asp-action="AddSet" class="btn btn-primary">Go</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Purchases</h5>
                <p class="card-text">View all purchases and piece purchase counts.</p>
                <a asp-action="Purchases" class="btn btn-primary">Go</a>
            </div>
        </div>
    </div>
</div>

<p><a asp-controller="Home" asp-action="Index">Back to Home</a></p>

