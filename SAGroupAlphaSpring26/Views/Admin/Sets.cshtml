@using System.Text
@model IEnumerable<Set>
@{
    // This is for the string to show that represents the piece in the set.
    StringBuilder stringBuilder = new();
}
<div class="saBackground">
    <h1>Add or Edit Sets</h1>
</div>
<br />
<div>
    <p>
        <a asp-controller="Admin" asp-action="AddSet" class="btn-lg btn btn-outline-dark" style="background-color: mediumpurple" role="button">Add a set</a>
    </p>
    <table class="table saBackground">
        <tr>
            <th>Name</th>
            <th>Actions</th>
            <th>Pieces</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr class="saBackground">
                <td>@item.Name</td>
                <td>
                    <a asp-controller="admin" asp-action="editset" asp-route-id="@item.Id" class="admin-edit-btn">Edit</a>
                </td>
                <td>
                    @if (item.PiecesList != null && item.PiecesList.Any())
                    {
                        foreach(var piece in item.PiecesList)
                        {
                        // piecesToShow += $"{piece.Piece.Name}, ";   
                        stringBuilder.Append($"{piece.Piece.Name}, ");
                        }
                        <p>@stringBuilder.ToString()</p>
                        stringBuilder.Clear();
                    }
                    else
                    {
                        <p>No pieces found.</p>
                    }
                </td>
            </tr>
        }
    </table>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}