@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<!-- Login Form Container - Centered on page, slightly narrower than register -->
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <!-- Card Header - Gold background with dark text to match D&D theme -->
            <div class="card-header" style="background: linear-gradient(180deg, #d4af37, #b8962e); border-bottom: 2px solid #f5d76e;">
                <h2 class="mb-0" style="color: #1a120d;">Sign In</h2>
            </div>
            
            <!-- Card Body - Contains the login form with parchment background -->
            <div class="card-body" style="background-color: #F5DEB3;">
                <!-- Form submits to the Login action in AccountController via POST -->
                <form asp-action="Login" method="post">
                    <!-- Displays all model validation errors -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Email Address field - used to identify the user account -->
                    <div class="mb-3">
                        <label asp-for="EmailAddress" class="form-label"></label>
                        <!-- type="email" enables browser email validation -->
                        <input asp-for="EmailAddress" type="email" class="form-control" placeholder="Enter your email address" />
                        <!-- Displays validation error message for EmailAddress -->
                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>

                    <!-- Password field - type="password" masks characters for security -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Submit button - full width via d-grid gap-2 -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Sign In</button>
                    </div>
                </form>
            </div>
            
<!-- Card Footer - Link to registration page for new users -->
            <div class="card-footer text-center" style="background-color: #F5DEB3; border-top: 1px solid #4a4a4a;">
                <p class="mb-0">Don't have an account? <a asp-action="Register">Register here</a></p>
            </div>
        </div>
    </div>
</div>

<!-- Scripts section - renders client-side validation scripts -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
