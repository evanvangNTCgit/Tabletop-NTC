@model List<Piece>

@if(Model.Count <= 0)
{
    <p>You seem to own no pieces</p>
    <p>You should buy some!</p>
} else {
<table class="table">
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach(Piece piece in Model)
        {
            <tr>
                <td>@piece.Name</td>
                <td>@piece.Description</td>
                <td>@piece.PieceType.Name</td>
            </tr>
        }
    </tbody>
</table>
}