@using System.Security.Claims
@{
    string userGreeting = "Welcome!\nHere is your inventory";

    try{
        userGreeting = $"Welcome {User.FindFirst(ClaimTypes.Name)!.Value.ToString()}!\nHere is your inventory";
    }
    catch
    {
        // its okay we dont need the name 
        userGreeting = "Welcome!\nHere is your inventory";
    }
    }

@model List<Piece>

    <h1>@userGreeting</h1>

@if(Model.Count <= 0)
{
    <p>You seem to own no pieces</p>
    <p>You should buy some!</p>
} else {
    <table class="table saBackground">
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach(Piece piece in Model)
        {
            <tr>
                <td>@piece.Name</td>
                <td>@piece.Description</td>
                <td>
                    <img 
                        src="@piece.ImagePath"
                        height="50vh"
                        width="50vw"
                        />
                </td>
            </tr>
        }
    </tbody>
</table>
}