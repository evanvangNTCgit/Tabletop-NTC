@{
    ViewData["Title"] = "Access Denied";
}

<!-- Access Denied Page - Displayed when user lacks permission for a resource -->
<div class="text-center mt-5">
    <!-- Centered card with shadow, max width 500px -->
    <div class="card shadow mx-auto" style="max-width: 500px;">
        <div class="card-body">
            <!-- Warning Icon - SVG exclamation circle (red color) -->
            <div class="mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="text-danger" viewBox="0 0 16 16">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                </svg>
            </div>
            
            <!-- Page Title -->
            <h1 class="h3 mb-3">Access Denied</h1>
            
            <!-- Main error message -->
            <p class="lead">You don't have permission to access this resource.</p>
            
            <!-- Additional help text -->
            <p class="text-muted">Please contact the administrator if you believe this is an error.</p>
            
            <!-- Horizontal divider -->
            <hr />
            
            <!-- Button to return to home page -->
            <div class="d-grid gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
            </div>
    </div>
