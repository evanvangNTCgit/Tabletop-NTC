@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}

<!-- Change Password Form Container - Centered on page with Bootstrap grid -->
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <!-- Card Header - Gold background with dark text to match D&D theme -->
            <div class="card-header" style="background: linear-gradient(180deg, #d4af37, #b8962e); border-bottom: 2px solid #f5d76e;">
                <h2 class="mb-0" style="color: #1a120d;">Change Password</h2>
            </div>
            
            <!-- Card Body - Contains the change password form with parchment background -->
            <div class="card-body" style="background-color: #F5DEB3;">
                <!-- Form submits to the ChangePassword action in AccountController via POST -->
                <form asp-action="ChangePassword" method="post">
                    <!-- Displays all model validation errors (except property-specific) -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Current Password field -->
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter your current password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <!-- New Password field -->
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter a new password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <!-- Confirm New Password field -->
                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Confirm your new password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>

                    <!-- Submit button - full width via d-grid gap-2 -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Change Password</button>
                    </div>
                </form>
            </div>
            
<!-- Card Footer - Back to Edit Profile button -->
            <div class="card-footer text-center" style="background-color: #F5DEB3; border-top: 1px solid #4a4a4a;">
                <div class="d-grid gap-2">
                    <a asp-controller="Account" asp-action="Edit" class="btn btn-outline-dark">Back to Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts section - renders client-side validation scripts -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
