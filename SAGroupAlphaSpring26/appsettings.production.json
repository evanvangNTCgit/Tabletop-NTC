{
  "AllowedHosts": "*",
  "AppConfig": {
    "AppName": "NTC Interactive Tabletop Map"
  },
  "ConnectionStrings": {
    "DatabaseConnection": "Server=tcp:ntcsadb.database.windows.net,1433;Initial Catalog=SADB;Persist Security Info=False;User ID=ntc;Password=SA123$%^;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "outputTemplate": "{Timestamp} [{Level:u3} {RequestId}] {Message} {Exception}{NewLine}"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/NtcTableTopLogs.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp} [{Level:u3} {RequestId}] {Message} {Exception}{NewLine}"
        }
      }
    ]
  }
}
