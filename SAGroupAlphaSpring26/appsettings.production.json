{
  "AllowedHosts": "*",
  "AppConfig": {
    "AppName": "NTC Interactive Tabletop Map"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=./TabletopDatabase.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "outputTemplate": "{Timestamp} [{Level:u3} {RequestId}] {Message} {Exception}{NewLine}"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/NtcTableTopLogs.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp} [{Level:u3} {RequestId}] {Message} {Exception}{NewLine}"
        }
      }
    ]
  }
}
